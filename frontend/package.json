{
  "name": "artcreation-dv",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node set-env.dev.ts && ng serve --open",
    "start-local-ssl": "node set-env.dev.ts && ng serve --ssl true --ssl-cert D:/Dokumente/GitHub/artcreation-dv/local_ssl/localhost.crt --ssl-key D:/Dokumente/GitHub/artcreation-dv/local_ssl/localhost.key --open",
    "start:stag": "node set-env.ts && ng serve --configuration staging",
    "start:prod": "node set-env.ts && ng serve --configuration production",
    "build": "ng build",
    "build:stag": "node set-env.ts && ng build --configuration staging",
    "build:prod": "node set-env.ts && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:artcreation-dv": "node dist/artcreation-dv/server/server.mjs",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/ssr": "^22.2.6",
    "@babel/runtime": "^7.27.1",
    "@eslint/js": "^9.13.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "body-parser": "^1.20.2",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "glob": "^11.0.1",
    "rxjs": "~7.8.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "underscore": "^1.13.8",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/underscore": "^1.13.0",
    "angular-eslint": "22.6.0",
    "eslint": "^9.28.0",
    "istanbul-lib-instrument": "^6.0.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^5.0.0"
  }
}
